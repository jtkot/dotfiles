safe_source() {
	if [ -f "$1" ]; then
		# shellcheck disable=SC1090
		source "$1"
	fi
}
export -f safe_source

prepend_to_path() {
	if [ -d "$1" ]; then
		if [ -n "$PATH" ]; then
			PATH="$1:$PATH"
			return
		fi
		export PATH="$1"
	fi
}
export -f prepend_to_path

__load_homebrew() {
	local BREW="/opt/homebrew/bin/brew"
	if [ -f $BREW ] && [ -z "$(command -v brew)" ]; then
		export HOMEBREW_NO_ANALYTICS=1
		export HOMEBREW_NO_ASK=1
		export HOMEBREW_NO_EMOJI=1
		export HOMEBREW_NO_ENV_HINTS=1
		export HOMEBREW_UPGRADE_GREEDY=1
		# shellcheck disable=SC1090
		source <($BREW shellenv)
		MANPATH=$HOMEBREW_PREFIX/share/man$MANPATH # a bug in homebrew?
	fi
}

__load_nix() {
  if [ -z "$(command -v nix)" ]; then
	safe_source "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
  fi
}

__setup_nh() {
	local NH_FLAKE_LOCAL="$HOME/.config/system"
	if [ "$(command -v nh)" ] && [ -d "$NH_FLAKE_LOCAL" ]; then
		export NH_FLAKE="$NH_FLAKE_LOCAL"
	fi
}

safe_source "$HOME/.env"

export EDITOR GPG_TTY NIX_CONFIG
EDITOR="nvim"
GPG_TTY="$(tty)"
NIX_CONFIG="access-tokens = github.com=$NIX_GITHUB_API_KEY"

__load_homebrew
__load_nix
__setup_nh

prepend_to_path "$HOME/.local/bin"
if [ "$(command -v gem)" ]; then
	prepend_to_path "$(gem env gemdir)/bin"
fi

prepend_to_path "$HOME/.dotnet/tools"
safe_source "$HOME/.bashrc"
