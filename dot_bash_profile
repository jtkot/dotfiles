safe_source() {
	if [ -f "$1" ]; then
		# shellcheck disable=SC1090
		source "$1"
	fi
}
export -f safe_source

prepend_to_path() {
	if [ -d "$1" ]; then
		if [ -n "$PATH" ]; then
			PATH="$1:$PATH"
			return
		fi
		export PATH="$1"
	fi
}
export -f prepend_to_path

__load_homebrew() {
	local BREW="/opt/homebrew/bin/brew"
	if [ -f $BREW ] && [ -z "$(command -v brew)" ]; then
		export HOMEBREW_NO_ANALYTICS=1
		export HOMEBREW_NO_ASK=1
		export HOMEBREW_NO_EMOJI=1
		export HOMEBREW_NO_ENV_HINTS=1
		export HOMEBREW_UPGRADE_GREEDY=1
		# shellcheck disable=SC1090
		source <($BREW shellenv)
		MANPATH=$HOMEBREW_PREFIX/share/man$MANPATH # a bug in homebrew?
	fi
}

__setup_nh() {
	if [ "$(command -v nh)" ]; then
		local NH_HOME_FLAKE_LOCAL="$HOME/.config/nixos/hm"
		if [ -d "$NH_HOME_FLAKE" ]; then
			export NH_HOME_FLAKE="$NH_HOME_FLAKE_LOCAL"
		fi

		local NH_OS_FLAKE_LOCAL="$HOME/.config/nixos/system"
		if [ -d "$NH_OS_FLAKE" ]; then
			export NH_OS_FLAKE="$NH_OS_FLAKE_LOCAL"
		fi
	fi
}

export EDITOR GPG_TTY
EDITOR="nvim"
GPG_TTY="$(tty)"

__load_homebrew
safe_source "/etc/bash.bashrc"
prepend_to_path "$HOME/.local/bin"
__setup_nh
safe_source "$HOME/.env"
safe_source "$HOME/.bashrc"
