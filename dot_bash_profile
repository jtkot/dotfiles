safe_source() {
	if [ -f "$1" ]; then
		# shellcheck disable=SC1090
		source "$1"
	fi
}
export -f safe_source

prepend_to_path() {
	if [ -d "$1" ]; then
		if [ -n "$PATH" ]; then
			PATH="$1:$PATH"
			return
		fi
		export PATH="$1"
	fi
}
export -f prepend_to_path

__setup_nh() {
	local NH_FLAKE_LOCAL="$HOME/.config/system"
	if [ "$(command -v nh)" ] && [ -d "$NH_FLAKE_LOCAL" ]; then
		export NH_FLAKE="$NH_FLAKE_LOCAL"
	fi
}

# keep nix available after macOS updates
if [ -z "$(command -v nix)" ]; then
	safe_source "/nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh"
fi
safe_source "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
safe_source "$HOME/.env"

__setup_nh

export EDITOR NIX_CONFIG
EDITOR="nvim"
NIX_CONFIG="access-tokens = github.com=$NIX_GITHUB_API_KEY"

prepend_to_path "$HOME/.local/bin"
if [ "$(command -v gem)" ]; then
	prepend_to_path "$(gem env gemdir)/bin"
fi

safe_source "$HOME/.bashrc"
