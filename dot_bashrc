source $HOME/.profile
source $HOME/.env

export EDITOR="nvim"

HOMEBREW_BASH_COMPLETION="$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"
if [ -r $HOMEBREW_BASH_COMPLETION ]; then
  export HOMEBREW_BASH_COMPLETION_USER_DIR="/Applications/Xcode.app/Contents/Developer/usr/share/bash-completion"
  source $HOMEBREW_BASH_COMPLETION
fi

if [ $(command -v nh) ]; then
	NH_HOME_FLAKE="$HOME/.config/nixos/hm"
	if [ -d $NH_HOME_FLAKE ]; then
		export NH_HOME_FLAKE
	fi

	NH_OS_FLAKE="$HOME/.config/nixos/system"
	if [ -d $NH_OS_FLAKE ]; then
		export NH_OS_FLAKE
	fi
fi

if [ -n "$GHOSTTY_RESOURCES_DIR" ]; then
    source $GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty.bash
fi


if [ $(command -v fzf) ]; then
	source <(fzf --bash)
fi

if [ $(command -v fj) ]; then
	alias berg="fj -H codeberg.org"
fi

if [ -x $(command -v info) ]; then
	alias info="info --vi-keys"
fi

if [ -x $(command -v llama-cli) ]; then
	alias gemma="llama-cli -hf unsloth/gemma-4-26b-a4b-it-GGUF:UD-IQ3_S -c 130000"
	alias qwen="llama-cli -hf unsloth/gemma-4-26b-a4b-it-GGUF:UD-IQ3_S -c 130000"
fi

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias .......="cd ../../../../../.."
alias ........="cd ../../../../../../.."
alias .........="cd ../../../../../../../.."

alias ls="ls --color=auto"
alias l="ls -l"
alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"

# exec {BASH_XTRACEFD}> /dev/null
shopt -s autocd
shopt -s histappend

GREEN="\[$(tput setaf 2)\]"
RESET="\[$(tput sgr0)\]"

export PS1="$GREEN\$(basename \$PWD) $RESET) "
