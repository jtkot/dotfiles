input {
    mouse {
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }
    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    // focus-follows-mouse max-scroll-amount="0%"
}

output "HDMI-A-1" {
    mode "3840x2160"
    scale 1.25
    hot-corners {
        off
    }
}

cursor {
    xcursor-size {{ .cursorSize }}
    xcursor-theme "{{ .cursorTheme }}"
}

layout {
    gaps 16
    center-focused-column "always"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

        // Fixed sets the width in logical pixels exactly.
        // fixed 1920
    }

    // You can also customize the heights that "switch-preset-window-height" (Ctrl+Super+Ctrl+Shift+R) toggles between.
    // preset-window-heights { }

    default-column-width { proportion 0.66667; }

    focus-ring {
        off
    }

    border {
        off
    }

    shadow {
        on
        // draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    // You can think of them as a kind of outer gaps. They are set in logical pixels.
    // Left and right struts will cause the next window to the side to always be visible.
    // Top and bottom struts will simply add outer gaps in addition to the area occupied by
    // layer-shell panels and regular gaps.
    struts {
        // left 64
        // right 64
        top -16
        // bottom 64
    }
}

// spawn-at-startup "qs"
// spawn-at-startup "walker" "--gapplication-service"

hotkey-overlay {
    skip-at-startup
}
prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
// You can also set this to null to disable saving screenshots to disk.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Open the Firefox picture-in-picture player as floating by default.
/-window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Example: block out two password managers from screen capture.
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    background-effect {
        blur true
        xray true
    }
}

blur {
    on
    passes 3
    offset 5
    saturation 1.5
    noise 0.05
}

binds {
    Ctrl+Super+Return hotkey-overlay-title="Open a Terminal: ghostty" { spawn "ghostty"; }
    Ctrl+Space hotkey-overlay-title="Run an Application: walker" { spawn "walker"; }
    Ctrl+Super+Q hotkey-overlay-title="Lock the Screen" { spawn "loginctl" "lock-session"; }

    // Use spawn-sh to run a shell command. Do this if you need pipes, multiple commands, etc.
    // Note: the entire command goes as a single argument. It's passed verbatim to `sh -c`.
    // For example, this is a standard bind to toggle the screen reader (orca).
    // Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }

    // XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-e4" "--class=backlight" "set" "5%+"; }
    // XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "--class=backlight" "set" "5%-" "-n2"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "ddcutil" "setvcp" "10" "+" "5"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "ddcutil" "setvcp" "10" "-" "5"; }

    Ctrl+Super+O repeat=false { toggle-overview; }
    Ctrl+Q repeat=false { close-window; }

    // Ctrl+Super+Left  { focus-column-left; }
    // Ctrl+Super+Down  { focus-window-down; }
    // Ctrl+Super+Up    { focus-window-up; }
    // Ctrl+Super+Right { focus-column-right; }
    Ctrl+Super+H     { focus-column-left; }
    Ctrl+Super+J     { focus-window-or-workspace-down; }
    Ctrl+Super+K     { focus-window-or-workspace-up; }
    // Ctrl+Super+J     { focus-window-down; }
    // Ctrl+Super+K     { focus-window-up; }
    Ctrl+Super+L     { focus-column-right; }

    // Ctrl+Super+Shift+Left  { move-column-left; }
    // Ctrl+Super+Shift+Down  { move-window-down; }
    // Ctrl+Super+Shift+Up    { move-window-up; }
    // Ctrl+Super+Shift+Right { move-column-right; }
    Ctrl+Super+Shift+H     { move-column-left; }
    Ctrl+Super+Shift+J     { move-window-down-or-to-workspace-down; }
    Ctrl+Super+Shift+K     { move-window-up-or-to-workspace-up; }
    // Ctrl+Super+Shift+J     { move-window-down; }
    // Ctrl+Super+Shift+K     { move-window-up; }
    Ctrl+Super+Shift+L     { move-column-right; }

    Ctrl+Super+Home { focus-column-first; }
    Ctrl+Super+End  { focus-column-last; }
    Ctrl+Super+Shift+Home { move-column-to-first; }
    Ctrl+Super+Shift+End  { move-column-to-last; }

    Ctrl+Super+Right             { focus-column-right; }
    Ctrl+Super+Left              { focus-column-left; }

    // Ctrl+Super+Shift+Page_Down { move-column-to-workspace-down; }
    // Ctrl+Super+Shift+Page_Up   { move-column-to-workspace-up; }
    // Ctrl+Super+Shift+D         { move-column-to-workspace-down; }
    // Ctrl+Super+Shift+U         { move-column-to-workspace-up; }

    // Ctrl+Super+Shift+Page_Down { move-workspace-down; }
    // Ctrl+Super+Shift+Page_Up   { move-workspace-up; }
    // Ctrl+Super+Shift+U         { move-workspace-down; }
    // Ctrl+Super+Shift+I         { move-workspace-up; }

    // To avoid scrolling through workspaces really fast, you can use
    // the cooldown-ms property. The bind will be rate-limited to this value.
    // You can set a cooldown on any bind, but it's most useful for the wheel.
    Ctrl+Super+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Ctrl+Super+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Ctrl+Super+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Ctrl+Super+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Ctrl+Super+WheelScrollRight      { focus-column-right; }
    Ctrl+Super+WheelScrollLeft       { focus-column-left; }
    Ctrl+Super+Shift+WheelScrollRight { move-column-right; }
    Ctrl+Super+Shift+WheelScrollLeft  { move-column-left; }

    // Usually scrolling up and down with Shift in applications results in
    // horizontal scrolling

    Ctrl+Super+1 { focus-workspace 1; }
    Ctrl+Super+2 { focus-workspace 2; }
    Ctrl+Super+3 { focus-workspace 3; }
    Ctrl+Super+4 { focus-workspace 4; }
    Ctrl+Super+5 { focus-workspace 5; }
    Ctrl+Super+6 { focus-workspace 6; }
    Ctrl+Super+7 { focus-workspace 7; }
    Ctrl+Super+8 { focus-workspace 8; }
    Ctrl+Super+9 { focus-workspace 9; }
    Ctrl+Super+Shift+1 { move-column-to-workspace 1; }
    Ctrl+Super+Shift+2 { move-column-to-workspace 2; }
    Ctrl+Super+Shift+3 { move-column-to-workspace 3; }
    Ctrl+Super+Shift+4 { move-column-to-workspace 4; }
    Ctrl+Super+Shift+5 { move-column-to-workspace 5; }
    Ctrl+Super+Shift+6 { move-column-to-workspace 6; }
    Ctrl+Super+Shift+7 { move-column-to-workspace 7; }
    Ctrl+Super+Shift+8 { move-column-to-workspace 8; }
    Ctrl+Super+Shift+9 { move-column-to-workspace 9; }

    // Alternatively, there are commands to move just a single window:
    // Ctrl+Super+Ctrl+1 { move-window-to-workspace 1; }

    // Switches focus between the current and the previous workspace.
    // Ctrl+Super+Tab { focus-workspace-previous; }

    // The following binds move the focused window in and out of a column.
    // If the window is alone, they will consume it into the nearby column to the side.
    // If the window is already in a column, they will expel it out.
    // Ctrl+Super+BracketLeft  { consume-or-expel-window-left; }
    // Ctrl+Super+BracketRight { consume-or-expel-window-right; }

    // Consume one window from the right to the bottom of the focused column.
    // Ctrl+Super+Comma  { consume-window-into-column; }
    // Expel the bottom window from the focused column to the right.
    // Ctrl+Super+Period { expel-window-from-column; }

    Ctrl+Super+R { switch-preset-column-width; }
    Ctrl+Super+Shift+R { switch-preset-column-width-back; }

    Ctrl+Super+F { maximize-column; }
    // Ctrl+Super+Shift+F { fullscreen-window; }

    // While maximize-column leaves gaps and borders around the window,
    // maximize-window-to-edges doesn't: the window expands to the edges of the screen.
    // This bind corresponds to normal window maximizing,
    // e.g. by double-clicking on the titlebar.
    // Ctrl+Super+M { maximize-window-to-edges; }

    // Expand the focused column to space not taken up by other fully visible columns.
    // Makes the column "fill the rest of the space".
    // Ctrl+Super+Shift+F { expand-column-to-available-width; }

    Ctrl+Super+Minus { set-column-width "-10%"; }
    Ctrl+Super+Equal { set-column-width "+10%"; }
    Ctrl+Super+Shift+Minus { set-window-height "-10%"; }
    Ctrl+Super+Shift+Equal { set-window-height "+10%"; }

    // Move the focused window between the floating and the tiling layout.
    // Ctrl+Super+V       { toggle-window-floating; }
    // Ctrl+Super+Shift+V { switch-focus-between-floating-and-tiling; }

    // Toggle tabbed column display mode.
    // Windows in this column will appear as vertical tabs,
    // rather than stacked on top of each other.
    // Ctrl+Super+W { toggle-column-tabbed-display; }

    Ctrl+Shift+3 { screenshot-screen; }
    Ctrl+Shift+4 { screenshot-window; }
    Ctrl+Shift+5 { screenshot; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The allow-inhibiting=false property can be applied to other binds as well,
    // which ensures niri always processes them, even when an inhibitor is active.
    // Ctrl+Super+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
