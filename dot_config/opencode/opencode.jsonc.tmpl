{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"small_model": "deepseek/deepseek-v4-flash",
	"model": "deepseek/deepseek-v4-pro",
	"mcp": {
		"Ghidra": {
			"enabled": false,
			"type": "local",
			"command": [
				"nix",
				"develop",
				"{{- .chezmoi.homeDir -}}/Repositories/ghidra-mcp",
				"--command",
				"python",
				"{{- .chezmoi.homeDir -}}/Repositories/ghidra-mcp/bridge_mcp_ghidra.py"
			]
		},
		"Cloudflare Docs": {
			"type": "remote",
			"url": "https://docs.mcp.cloudflare.com/mcp",
			"enabled": false
		},
		"Astro Docs": {
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp",
			"enabled": false
		},
		"localhost HTTP": {
			"type": "remote",
			"url": "http://127.0.0.1:8080/mcp",
			"enabled": false
		}
	}
}
