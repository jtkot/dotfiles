encryption = "gpg"

[gpg]
recipient = "74865B39CC76129E"

{{ $fontSizes := dict "jan-macbook" 14 -}}
{{- $cellHeights := dict "jan-macbook" 55 -}}
{{- $imhexSharePaths := dict "darwin" "/Applications/ImHex.app/Contents/MacOS" -}}
{{- $tmuxPaths := dict "darwin" "/opt/homebrew/bin/tmux" -}}
{{- $ytDlpPaths := dict "darwin" "/opt/homebrew/bin/yt-dlp" -}}
{{- $imhexDefaultSharePath:= joinPath .chezmoi.homeDir ".nix-profile/share/imhex" -}}

[merge]
command = "nvim"
args = [
  "-d",
  "{{ "{{" }} .Destination {{ "}}" }}",
  "{{ "{{" }} .Source {{ "}}" }}",
  "{{ "{{" }} .Target {{ "}}" }}",
]

[data]
fontSize = {{ index $fontSizes .chezmoi.hostname | default 11 }}
cellHeight = {{ index $cellHeights .chezmoi.hostname | default 60 }}
imhexSharePath = "{{ index $imhexSharePaths .chezmoi.os | default $imhexDefaultSharePath }}"
tmuxPath = "{{ index $tmuxPaths .chezmoi.os | default "/usr/bin/tmux" }}"
ytDlpPath = "{{ index $ytDlpPaths .chezmoi.os | default "/usr/bin/yt-dlp" }}"
{{- if ne .chezmoi.os "darwin" }}
cursorTheme = "macOS"
cursorSize = 28
{{- end }}
