# :schema https://developers.openai.com/codex/config-schema.json

check_for_update_on_startup = false
model = "deepseek-v4-pro"
plan_mode_reasoning_effort = "xhigh"
model_catalog_json = "catalog.json"
model_provider = "openrouter"
model_reasoning_effort = "medium"
sandbox_mode = "workspace-write"
show_raw_agent_reasoning = false
analytics.enabled = false
skills.bundled.enabled = false
features.memories = true

[tui]
show_tooltips = false
vim_mode_default = true
status_line_use_colors = true
status_line = [
  "model-with-reasoning",
  "project-name",
  "context-used",
  "task-progress"
]

[model_providers.openrouter]
name = "OpenRouter"
base_url = "https://openrouter.ai/api/v1"
env_key = "OPENROUTER_API_KEY"
wire_api = "responses"
http_headers = { HTTP-Referer = "https://openai.com/codex/", X-OpenRouter-Title = "Codex" }
env_http_headers = { x-session-id = "CODEX_THREAD_ID" }

[mcp_servers.cloudflare-docs]
enabled = false
url = "https://docs.mcp.cloudflare.com/mcp"

[mcp_servers.ghidra]
enabled = false
command = "nix"
args = [
  "develop",
  "{{- .chezmoi.homeDir -}}/Repositories/ghidra-mcp",
  "--command",
  "python",
  "{{- .chezmoi.homeDir -}}/Repositories/ghidra-mcp/bridge_mcp_ghidra.py"
]

[mcp_servers.localhost]
enabled = false
url = "http://127.0.0.1:8080/mcp"

[[hooks.PreToolUse]]
matcher = "^Bash$"

[[hooks.PreToolUse.hooks]]
type = "command"
command = "rtk hook claude --ultra-compact"
timeout = 5
